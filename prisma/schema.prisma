// =====================================================================
//  RO Water Service Provider — CRM + AI Telecalling
//  Database schema (Prisma)
//
//  NOTE ON PORTABILITY
//  -------------------
//  This schema intentionally uses only portable scalar types
//  (String / Int / Float / Boolean / DateTime) so it runs out-of-the-box
//  on SQLite for local development and on PostgreSQL in production.
//
//  "Enum" values (role, status, source, intent...) are stored as String
//  and enforced in the application layer via src/lib/enums.ts — this keeps
//  the exact same schema working on both engines.
//
//  To switch to PostgreSQL for production:
//    1. provider = "postgresql"
//    2. set DATABASE_URL="postgresql://..."
//    3. npm run db:push && npm run db:seed
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
//  Users (staff) — roles: OWNER | MANAGER | TEAM_LEAD | AGENT | TECHNICIAN | ACCOUNTANT
// ---------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("AGENT")
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  assignedLeads Lead[]       @relation("AssignedTo")
  ownedLeads    Lead[]       @relation("Owner")
  calls         Call[]
  activities    Activity[]
  tickets       Ticket[]     @relation("TicketAssignee")
  serviceJobs   ServiceJob[] @relation("Technician")
}

// ---------------------------------------------------------------------
//  Campaigns (cold-calling campaigns / ad channels)
// ---------------------------------------------------------------------
model Campaign {
  id         String   @id @default(cuid())
  name       String
  channel    String   @default("OUTBOUND")
  status     String   @default("ACTIVE")
  script     String?
  dailyLimit Int      @default(300)
  createdAt  DateTime @default(now())

  leads Lead[]
}

// ---------------------------------------------------------------------
//  Leads — the single unified pipeline (cold-call + online)
// ---------------------------------------------------------------------
model Lead {
  id              String    @id @default(cuid())
  name            String
  phone           String    @unique
  email           String?
  city            String?
  area            String?
  language        String    @default("hi")
  source          String    @default("COLD_UPLOAD")
  status          String    @default("NEW")
  intent          String?
  score           Int?
  dnd             Boolean   @default(false)
  consent         Boolean   @default(false)
  isCustomer      Boolean   @default(false)
  tags            String?
  bestTime        String?
  notes           String?
  campaignId      String?
  assignedToId    String?
  ownerId         String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign   Campaign?    @relation(fields: [campaignId], references: [id])
  assignedTo User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  owner      User?        @relation("Owner", fields: [ownerId], references: [id])
  calls      Call[]
  activities Activity[]
  tickets    Ticket[]
  messages   Message[]
  serviceJobs ServiceJob[]

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

// ---------------------------------------------------------------------
//  Calls — every AI or human call, with transcript + AI analysis
// ---------------------------------------------------------------------
model Call {
  id           String    @id @default(cuid())
  leadId       String
  direction    String    @default("OUTBOUND")
  status       String    @default("QUEUED")
  duration     Int       @default(0)
  recordingUrl String?
  transcript   String?
  summary      String?
  sentiment    String?
  disposition  String?
  aiScore      Int?
  handledByAi  Boolean   @default(true)
  agentId      String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent User? @relation(fields: [agentId], references: [id])

  @@index([leadId])
  @@index([status])
}

// ---------------------------------------------------------------------
//  Activity timeline per lead
// ---------------------------------------------------------------------
model Activity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String?
  meta      String?
  userId    String?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
}

// ---------------------------------------------------------------------
//  Tickets — human hand-off / callback requests
// ---------------------------------------------------------------------
model Ticket {
  id             String    @id @default(cuid())
  leadId         String?
  subject        String
  reason         String?
  priority       String    @default("HIGH")
  status         String    @default("OPEN")
  assignedToId   String?
  customerPhone  String
  preferredTime  String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@index([status])
}

// ---------------------------------------------------------------------
//  Messages — WhatsApp / SMS log
// ---------------------------------------------------------------------
model Message {
  id        String   @id @default(cuid())
  leadId    String
  channel   String   @default("WHATSAPP")
  direction String   @default("OUTBOUND")
  body      String
  status    String   @default("SENT")
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ---------------------------------------------------------------------
//  Service jobs — installations, AMC, repair, parts
// ---------------------------------------------------------------------
model ServiceJob {
  id           String    @id @default(cuid())
  leadId       String?
  customerId   String?
  type         String    @default("REPAIR")
  status       String    @default("SCHEDULED")
  scheduledAt  DateTime?
  technicianId String?
  address      String?
  amount       Float?
  invoiceUrl   String?
  createdAt    DateTime  @default(now())

  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  technician User? @relation("Technician", fields: [technicianId], references: [id])

  @@index([status])
}

// ---------------------------------------------------------------------
//  Payments / invoices
// ---------------------------------------------------------------------
model Payment {
  id        String   @id @default(cuid())
  jobId     String?
  amount    Float
  status    String   @default("PENDING")
  method    String?
  invoiceNo String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
//  Knowledge base (RAG) for the AI voice agent
// ---------------------------------------------------------------------
model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
//  Audit log
// ---------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
//  Inbound webhook events (Twilio / OpenAI / Ads)
// ---------------------------------------------------------------------
model WebhookEvent {
  id        String   @id @default(cuid())
  source    String
  payload   String
  createdAt DateTime @default(now())
}
