# ---- Database ----
# Local development (zero-setup): SQLite
DATABASE_URL="file:./dev.db"
# Leave DATABASE_PROVIDER unset (or "sqlite") for local development.
# On Vercel / any Postgres host, set DATABASE_PROVIDER="postgresql" and use:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/ro_crm?schema=public"

# ---- One-time remote seeding (optional) ----
# Set a secret to enable GET /api/admin/seed?secret=... on a deployment.
# SEED_SECRET="pick-a-long-random-string"

# ---- Auth ----
AUTH_SECRET="change-me-to-a-long-random-string-in-production-0000"

# ---- AI Provider (Twilio + OpenAI GPT-4o Realtime) ----
# Leave AI_MODE=mock to run the full platform WITHOUT any paid keys.
# Set AI_MODE=live and fill the keys below to enable real AI telecalling.
AI_MODE="mock"

OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ---- Messaging / Payments (optional) ----
WHATSAPP_FROM=""
SMTP_URL=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_NAME="WaterPure RO Services"
NEXT_PUBLIC_COMPANY_PHONE="+91-90000-00000"
